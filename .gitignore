# Dependencies
node_modules/

# Build output
dist/
target/
*.tsbuildinfo

# Local database and backups (the app writes to ~/.savingbuddy, but older
# builds used a relative path — keep this so a stray one is never committed)
data/

# Local env and editor noise — secrets never enter git.
# .env.example is the committed template and holds no real values.
.env
.env.*
!.env.example
.DS_Store
.idea/
*.iml
.vscode/

# Goldens captured from a real database contain actual balances and salary.
# Only the demo-household goldens belong in git.
frontend/src/test/goldens/*.json
!frontend/src/test/goldens/*-demo.json

# Copy to .env.local for your own notes. NEVER commit a filled-in copy —
# .gitignore covers .env* and Render holds the real values (sync: false).
#
# Local development needs NONE of this: the default profile uses H2 at
# ~/.savingbuddy/db and open (loopback-only) registration.

# Activates the deployment profile. Forgetting this is the most dangerous
# mistake possible: the app boots happily on H2 in ephemeral container storage,
# with no error anywhere, and every account vanishes on the next deploy.
SPRING_PROFILES_ACTIVE=postgres

# Supabase SESSION POOLER (port 5432), not the direct connection and not the
# transaction pooler. Direct connections are IPv6-only on Supabase free and
# Render has no IPv6; the transaction pooler (6543) has no prepared-statement
# support, which Hibernate needs, and breaks Flyway's session-scoped locking.
DATABASE_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_USERNAME=postgres.<project-ref>
DATABASE_PASSWORD=

# Who may create an account. `code` requires REGISTRATION_CODE of >=16 chars or
# the app refuses to start — it will not deploy accidentally open.
REGISTRATION_MODE=code
REGISTRATION_CODE=

# Render terminates TLS and forwards plain HTTP with X-Forwarded-*.
FORWARD_HEADERS_STRATEGY=native
SECURE_COOKIES=true
SERVER_ADDRESS=0.0.0.0

# Optional: connection pool bounds against a small free-tier budget.
# DB_POOL_MAX=5
# DB_POOL_MIN=1
